    {
      "name": "7. Use Case 5 - Premium Calculation",
      "item": [
        {
          "name": "7.1 Calculate Annual Premium (Customer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sumAssured\": 500000.00,\n  \"age\": 28,\n  \"termYears\": 10,\n  \"paymentFrequency\": \"ANNUAL\",\n  \"rateOfInterest\": 6.50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/calculator/premium",
              "host": ["{{baseUrl}}"],
              "path": ["api", "calculator", "premium"]
            }
          }
        },
