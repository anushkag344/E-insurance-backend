            "body": {
              "mode": "raw",
              "raw": "{\n  \"bankName\": \"HDFC Bank\",\n  \"branchName\": \"Connaught Place\",\n  \"ifscCode\": \"HDFC0000123\",\n  \"accountNumber\": \"50100234567890\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/banks",
