              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planName\": \"Life Protection Plan\",\n  \"planDetails\": \"Comprehensive life protection and savings plans\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/plans",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "plans"]
