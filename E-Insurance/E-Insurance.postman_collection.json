              "mode": "raw",
              "raw": "{\n  \"bankName\": \"HDFC Bank Ltd\",\n  \"branchName\": \"Connaught Place Central\",\n  \"ifscCode\": \"HDFC0000123\",\n  \"accountNumber\": \"50100234567890\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/banks/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "banks", "1"]
            }
          }
        },
        {
          "name": "3.5 Delete Bank (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/banks/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "banks", "1"]
            }
          }
        }
      ]
    },
