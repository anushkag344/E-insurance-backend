{
  "info": {
    "name": "E-Insurance Management System",
    "description": "Postman Collection for E-Insurance Backend covering Use Cases 1 to 6: Authentication, View Policies, Admin User/Bank Management, Policy Purchase, Premium Calculation, and Commission Calculation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "agentToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Use Case 1 - Authentication",
      "item": [
        {
          "name": "1.1 Register Admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin1\",\n  \"password\": \"Admin@123\",\n  \"email\": \"admin1@insurance.com\",\n  \"fullName\": \"Super Admin\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/admin/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "admin", "register"]
            }
          }
        },
        {
          "name": "1.2 Register Agent",
