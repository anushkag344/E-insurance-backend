{
  "info": {
    "name": "E-Insurance Management System",
    "description": "Postman Collection for E-Insurance Backend covering Use Cases 1 to 4: Authentication, View Policies, Admin User/Bank Management, and Policy Purchase.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Use Case 1 - Authentication",
      "item": [
        {
          "name": "1.1 Register Admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin1\",\n  \"password\": \"Admin@123\",\n  \"email\": \"admin1@insurance.com\",\n  \"fullName\": \"Super Admin\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/admin/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "admin", "register"]
            }
          }
        },
        {
          "name": "1.2 Register Agent",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"agent1\",\n  \"password\": \"Agent@123\",\n  \"email\": \"agent1@insurance.com\",\n  \"fullName\": \"Rahul Sharma\",\n  \"role\": \"AGENT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/agent/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "agent", "register"]
            }
          }
        },
        {
          "name": "1.3 Register Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"customer1\",\n  \"password\": \"Customer@123\",\n  \"email\": \"customer1@example.com\",\n  \"fullName\": \"Priya Singh\",\n  \"phone\": \"9876543210\",\n  \"dateOfBirth\": \"1995-05-15\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/customer/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "customer", "register"]
            }
          }
        },
        {
          "name": "1.4 Register Employee",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"employee1\",\n  \"password\": \"Employee@123\",\n  \"email\": \"employee1@insurance.com\",\n  \"fullName\": \"Amit Verma\",\n  \"role\": \"EMPLOYEE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/employee/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "employee", "register"]
            }
          }
        },
        {
          "name": "1.5 Login Admin (Save Token to adminToken)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin1\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "1.6 Login Customer (Save Token to customerToken)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"customer1\",\n  \"password\": \"Customer@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Use Case 3 - Admin Setup Plans & Schemes",
      "item": [
        {
          "name": "2.1 Create Insurance Plan (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planName\": \"Life Protection Plan\",\n  \"planDetails\": \"Comprehensive life protection and savings plans\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/plans",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "plans"]
            }
          }
        },
        {
          "name": "2.2 List Insurance Plans (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/plans",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "plans"]
            }
          }
        },
        {
          "name": "2.3 Create Scheme under Plan (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"schemeName\": \"Term Life Secure 2026\",\n  \"schemeDetails\": \"High coverage term insurance with accidental benefit\",\n  \"planId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/schemes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "schemes"]
            }
          }
        },
        {
          "name": "2.4 List Schemes (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/schemes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "schemes"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Use Case 3 - Admin Manage Banks",
      "item": [
        {
          "name": "3.1 Create Bank (Admin)",
